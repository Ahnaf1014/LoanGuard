# Copy this file to .env and replace the values for your MySQL installation.
# For Aiven/MySQL providers, DB_SSL_CA may be either:
#   - a file path on disk, or
#   - the raw PEM certificate text copied from the service's CA certificate
SECRET_KEY=replace-with-a-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_NAME=LoanGuard
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
FLASK_DEBUG=true
