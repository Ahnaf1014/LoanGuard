# Copy this file to .env and replace the values for your MySQL installation.
# For Aiven/MySQL providers, DB_SSL_CA may be either:
#   - a file path on disk, or
#   - the raw PEM certificate text copied from the service's CA certificate
SECRET_KEY=replace-with-a-random-secret
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=LoanGuard
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
# Set true only when the app is always served over HTTPS.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
FLASK_DEBUG=true
